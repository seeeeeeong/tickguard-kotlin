root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# The original wrapped at 100. Kotlin's generic signatures run longer than
# TypeScript's, and 120 is what detekt's MaxLineLength defaults to, so the two
# tools agree without either being configured against the other.
max_line_length = 120

[*.{yml,yaml,json,toml,md}]
indent_size = 2
